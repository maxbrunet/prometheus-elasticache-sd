{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:gomodIndirectSecurityUpdates"
  ],
  "assignees": ["maxbrunet"],
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "One week stability period for Go packages",
      "matchDatasources": ["go"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group packages from aws-sdk-go-v2 monorepo together",
      "matchSourceUrls": ["https://github.com/aws/aws-sdk-go-v2{/,}**"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"],
      "groupName": "aws-sdk-go-v2 monorepo"
    },
    {
      "description": "Exclude retracted Prometheus versions: https://github.com/renovatebot/renovate/issues/13012",
      "matchPackageNames": ["github.com/prometheus/prometheus"],
      "allowedVersions": "<1"
    },
    {
      "matchDepTypes": ["require"],
      "semanticCommitType": "build"
    },
    {
      "matchPackageNames": ["go"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "semanticCommitType": "build"
    },
    {
      "matchDepTypes": ["kos.base_image"],
      "semanticCommitType": "build"
    }
  ],
  "customDatasources": {
    "riscv-runners": {
      "description": "RISE RISC-V runner labels track the ubuntu os-versions in the riscv-runner build matrix",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/riseproject-dev/riscv-runner/main/.github/workflows/deploy-runner.yml",
      "format": "yaml",
      "transformTemplates": [
        "{'releases': jobs.`build-images`.strategy.matrix.include.{'version': `os-version` & '-riscv'}, 'sourceUrl': 'https://github.com/riseproject-dev/riscv-runner', 'homepage': 'https://riscv-runners.riseproject.dev/'}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "Update base image in .goreleaser.yml",
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/(^|/)\\.goreleaser\\.ya?ml$/"],
      "matchStrings": [
        "kos.$match(base_image, /^(.+?)(?::(.+?))?(?:@(sha256:.+))?$/).{ 'depName': groups[0], 'currentValue': groups[1], 'currentDigest': groups[2] }"
      ],
      "autoReplaceStringTemplate": "{{depName}}{{#if newValue}}:{{newValue}}{{/if}}{{#if newDigest}}@{{newDigest}}{{/if}}",
      "datasourceTemplate": "docker",
      "depTypeTemplate": "kos.base_image",
      "versioningTemplate": "docker"
    },
    {
      "description": "Update GitHub Actions runner labels in strategy.matrix runs-on",
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": [
        "jobs.test.strategy.matrix.`runs-on`[$match($, /^[a-z]+-[0-9]+\\.[0-9]+/)].{ 'depName': $substringBefore($, '-'), 'currentValue': $substringAfter($, '-') }"
      ],
      "datasourceTemplate": "{{#if (containsString currentValue \"-riscv\")}}custom.riscv-runners{{else}}github-runners{{/if}}",
      "versioningTemplate": "docker",
      "depTypeTemplate": "github-runner"
    }
  ]
}
